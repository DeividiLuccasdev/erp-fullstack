generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}
datasource db {
  provider = "postgresql"
}

enum Perfil {
  ADMIN
  OPERADOR
}

model Usuario {
  id            String   @id @default(cuid())
  nome          String
  email         String   @unique
  senhaHash     String
  perfil        Perfil   @default(OPERADOR)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm DateTime  @updatedAt
  

  movimentacoesEstoque MovimentacaoEstoque[]
    pedidos Pedido[]
}
model Cliente {
  id           String    @id @default(cuid())
  nome         String
  cpf          String?   @unique
  email        String?
  telefone     String?
  cidade       String?
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  pedidos Pedido[]
}
model Produto {
  id                   String                @id @default(cuid())
  nome                 String
  codigo               String                @unique
  descricao            String?
  preco                Decimal               @db.Decimal(10, 2)
  estoque              Int                   @default(0)
  estoqueMinimo        Int                   @default(0)
  ativo                Boolean               @default(true)
  criadoEm             DateTime              @default(now())
  atualizadoEm         DateTime              @updatedAt


  movimentacoesEstoque MovimentacaoEstoque[]
  itensPedido ItemPedido[]
}
enum TipoMovimentacao {
  ENTRADA
  SAIDA
}
model MovimentacaoEstoque {
  id         String           @id @default(cuid())
  produtoId  String
  usuarioId  String
  tipo       TipoMovimentacao
  quantidade Int



  observacao String?
  criadoEm   DateTime         @default(now())

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)



  @@index([produtoId])
  @@index([usuarioId])
}

enum StatusPedido {
  ABERTO
  FINALIZADO
  CANCELADO
}
model Pedido {
  id           String       @id @default(cuid())
  clienteId    String?
  usuarioId    String
  status       StatusPedido @default(ABERTO)
  total        Decimal      @default(0) @db.Decimal(12, 2)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  finalizadoEm DateTime?
  canceladoEm DateTime?

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  itens ItemPedido[]

  @@index([clienteId])
  @@index([usuarioId])
}

model ItemPedido {
  id            String  @id @default(cuid())
  pedidoId      String
  produtoId     String
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(12, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@index([produtoId])
}